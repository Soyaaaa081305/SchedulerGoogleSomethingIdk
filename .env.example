# Database
DATABASE_URL="file:./dev.db"

# Google Gemini (free API key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Google OAuth (see README — Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Web push (generate with: npx web-push generate-vapid-keys --json)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Protects /api/cron (Vercel injects this as a Bearer token automatically)
CRON_SECRET=""

# Server timezone
TZ="Asia/Manila"